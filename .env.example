# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=troque_em_producao

# ─── API ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ponto_user:troque_em_producao@localhost:5432/ponto_db
JWT_SECRET=troque_por_string_aleatoria_longa_min_32_chars
JWT_EXPIRES_IN=15m
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Em produção: domínio do frontend (ex: https://ponto.vercel.app)
CORS_ORIGINS=http://localhost:5173

# ─── Web ──────────────────────────────────────────────────────────────────────
# Com Docker (nginx proxy): deixar /api/v1
# Sem Docker / dev: URL completa da API
VITE_API_URL=/api/v1
